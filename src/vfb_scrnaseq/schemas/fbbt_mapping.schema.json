{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://virtualflybrain.org/schemas/fbbt_mapping.schema.json",
  "title": "FBbt mapping result",
  "description": "Result of mapping one scRNAseq cluster label to a Drosophila anatomy (FBbt) term.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cluster_label",
    "working_definition",
    "searches_performed",
    "best_match",
    "justification",
    "other_candidates",
    "recommendation",
    "new_term_needed",
    "verification_needed"
  ],
  "properties": {
    "cluster_label": {
      "type": "string"
    },
    "working_definition": {
      "type": "string"
    },
    "searches_performed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "best_match": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fbbt_term",
            "fbbt_id",
            "fbbt_definition",
            "match_type",
            "skos_mapping",
            "confidence"
          ],
          "properties": {
            "fbbt_term": {
              "type": "string"
            },
            "fbbt_id": {
              "type": "string",
              "pattern": "^FBbt:[0-9]{8}$"
            },
            "fbbt_definition": {
              "type": "string"
            },
            "match_type": {
              "enum": [
                "exact match",
                "broad match",
                "narrow match"
              ]
            },
            "skos_mapping": {
              "enum": [
                "skos:exactMatch",
                "skos:broadMatch",
                "skos:narrowMatch"
              ]
            },
            "confidence": {
              "enum": [
                "high",
                "medium",
                "low"
              ]
            }
          }
        }
      ]
    },
    "additional_matches": {
      "type": "array",
      "description": "Further FBbt terms the cluster is equally composed primarily of, when the authors' name places it in more than one class (e.g. a group named for two neuropeptides). Same shape as best_match; best_match stays the primary term.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fbbt_term",
          "fbbt_id",
          "fbbt_definition",
          "match_type",
          "skos_mapping",
          "confidence"
        ],
        "properties": {
          "fbbt_term": {
            "type": "string"
          },
          "fbbt_id": {
            "type": "string",
            "pattern": "^FBbt:[0-9]{8}$"
          },
          "fbbt_definition": {
            "type": "string"
          },
          "match_type": {
            "enum": [
              "exact match",
              "broad match",
              "narrow match"
            ]
          },
          "skos_mapping": {
            "enum": [
              "skos:exactMatch",
              "skos:broadMatch",
              "skos:narrowMatch"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "justification": {
      "type": "string"
    },
    "other_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fbbt_term",
          "fbbt_id",
          "fbbt_definition",
          "reason_rejected"
        ],
        "properties": {
          "fbbt_term": {
            "type": "string"
          },
          "fbbt_id": {
            "type": "string",
            "pattern": "^FBbt:[0-9]{8}$"
          },
          "fbbt_definition": {
            "type": "string"
          },
          "reason_rejected": {
            "type": "string"
          }
        }
      }
    },
    "recommendation": {
      "type": "string"
    },
    "new_term_needed": {
      "type": "boolean",
      "description": "True only when NO adequate FBbt term exists at any level (best_match is null, or only a too-broad parent with no findable specific term). A genuine new-term candidate."
    },
    "verification_needed": {
      "type": "boolean",
      "description": "True when a plausible specific FBbt term EXISTS but its equivalence to this cluster is unconfirmed (e.g. a same-named subtype defined from a different source/modality). A curator-verification task, NOT a new term. Distinct from new_term_needed; both are false for a confident exact match."
    },
    "manual_edit": {
      "description": "Present ONLY when a human has hand-edited this mapping (i.e. it is not purely pipeline-generated). Records the non-reproducible curator intervention so a re-run does not silently erase it. Agents/scripts must NOT set this.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "date",
        "reason"
      ],
      "properties": {
        "by": {
          "type": "string",
          "description": "Who made the edit (name/ORCID/handle)."
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "change": {
          "type": "string",
          "description": "What was changed (e.g. 'best_match FBbt:00003770 -> FBbt:00052303; broad -> exact')."
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
