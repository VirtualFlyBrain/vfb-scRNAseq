{
  "project": "hormann_2020",
  "created_at": "2026-10-16",
  "updated_at": "2026-10-16",
  "summary": "Hörmann et al. 2020 (Development), single-cell 10x of FACS-sorted T4/T5 neurons at five pupal stages (24, 36, 48, 60, 72 h APF), rebuilt from GEO GSE147987 and the authors' per-cell labels in the Single Cell Expression Atlas (E-GEOD-147987), replacing the old FlyBase/SCEA load FBlc0006305 with fresh VFBseq ids. 10 Samples / Assays (two replicate libraries per stage), linked to the split-GAL4 combination FBco0000215 via GENO has_genotype. Five Clusterings (one per stage), one Cluster per author cluster (8 per stage, each one T4/T5 subtype): 40, all mapped to FBbt (immature subtype terms at 24 and 36 h APF, mature from 48 h) and loaded. Summary expression as CPM from the GEO raw counts (17,744 genes x 43,986 cells; 105,521 cluster x gene rows with extent > 0.2).",
  "decisions": [
    {
      "date": "2026-10-08",
      "by": "curator",
      "decision": "Map to cell-level FBbt terms only (a tissue or organ author term maps to its cell-level equivalent, else the type is held)."
    },
    {
      "date": "2026-10-14",
      "by": "curator",
      "decision": "Clusters with no FBbt term are held: listed in mapping.tsv with a hold_reason but not loaded (no VFBseq id, entity or expression rows). Their cells still count towards the Dataset's gene counts."
    },
    {
      "date": "2026-10-14",
      "by": "curator",
      "decision": "Summary expression is computed as CPM for every dataset."
    },
    {
      "date": "2026-10-16",
      "by": "curator",
      "decision": "Narrow a generic type by the dissected tissue only where the tissue makes the tissue-specific FBbt term exact; hold clusters that could only be typed as cell or neuron (or stage-specific versions); load glia under a glial-cell term."
    },
    {
      "date": "2026-10-16",
      "by": "curator",
      "decision": "Replace the old FlyBase/SCEA load FBlc0006305 (SCEA E-GEOD-147987; 5 stage clusterings x 8 subtypes, all mapped to mature terms) with fresh VFBseq ids; its assignments are a cross-check only. Licence CC-BY-4.0."
    },
    {
      "date": "2026-10-16",
      "by": "curator",
      "decision": "One Clustering per stage, one Cluster per author cluster (stage x subtype, from the authors' per-cell labels in SCEA); the cross-stage integrated clustering (Fig 3D, apparently the label's trailing number) is not loaded."
    },
    {
      "date": "2026-10-16",
      "by": "curator",
      "decision": "Stages by the Bainbridge & Bownes FBdv definitions (24 h P6, 36 h P7, 48 h P8, 60 and 72 h P9); Sample tissue brain to the pupal stage, adult brain from the pharate adult stage (whole brains dissected, T4/T5 sorted)."
    },
    {
      "date": "2026-10-16",
      "by": "curator",
      "decision": "Samples from a cross link the genetic entities in the genotype, not a stock (GENO:0000222 has_genotype; new genotype_includes slot): here the split-GAL4 combination SS00324 = FBco0000215; the UAS-mCD8::GFP insertion is not identified in the paper, so not linked. Samples from a defined stock or strain keep the stock link."
    },
    {
      "date": "2026-10-16",
      "by": "curator",
      "decision": "Immature subtype terms up to the pupal stage (24, 36 h APF), mature from the pharate adult stage (48-72 h APF), as for Özel 2021."
    },
    {
      "date": "2026-10-16",
      "by": "pipeline",
      "decision": "Samples from GEO: each GSM one sample with one 10x library (two replicates per stage); pooled sex (unset)."
    },
    {
      "date": "2026-10-16",
      "by": "pipeline",
      "decision": "Clusters: build_clusters.py takes each SCEA-labelled cell's subtype from its label and its stage from its library (BioSample -> GSM title); the authors give the per-stage clusters no numbers, so the subtype label is the cluster id. Type mappings by write_type_mappings.py (no judgement needed: one exact FBbt term per subtype, from OLS)."
    },
    {
      "date": "2026-10-16",
      "by": "pipeline",
      "decision": "Expression from the GEO filtered 10x matrices (raw UMI counts) combined side by side (combine_matrices.py), cell -> cluster from the memberships (the authors' labelled cells), CPM over each cell's own counts; level the mean CPM over expressing cells, extent the fraction expressing, rows kept with extent > 0.2; Ensembl 97 FBgn ids mapped to current FlyBase genes, transgene features dropped."
    },
    {
      "date": "2026-10-16",
      "by": "curator",
      "decision": "All 40 mapped clusters reviewed by the curator (mapping.tsv `reviewed`)."
    }
  ],
  "checks": [
    {
      "date": "2026-10-16",
      "check": "verify_mappings.py: every FBbt term in the mappings looked up in OLS (FBbt 2026-10-01).",
      "result": "16 terms current, not obsolete, labels match."
    },
    {
      "date": "2026-10-16",
      "check": "FBbt, FBdv and FBcv terms on the Samples, Assays and Dataset looked up in OLS.",
      "result": "All 8 terms current (pupal stage P6, P7, pharate adult stage P8, P9, brain, adult brain, single-cell RNA-Seq, 10x sequencing)."
    },
    {
      "date": "2026-10-16",
      "check": "FBco0000215 looked up in VFB production.",
      "result": "Present, as the class ScerGAL4[DBD.R42F06]∩HsapRELA[AD.R59E08] (intersectional expression pattern) with IRI http://flybase.org/reports/FBco0000215."
    },
    {
      "date": "2026-10-16",
      "check": "SCEA author labels against the paper and the GEO matrices.",
      "result": "43,986 cells labelled (the paper's ~44K high-quality cells), all in the GEO matrices; 8 subtypes at each of the 5 stages, as in the paper."
    },
    {
      "date": "2026-10-16",
      "check": "Cross-check against the old load FBlc0006305 (VFB production).",
      "result": "The same 40 clusters with identical cell numbers; the old load mapped all to mature terms (here immature at 24 and 36 h APF)."
    },
    {
      "date": "2026-10-16",
      "check": "Marker spot checks in the expression output.",
      "result": "dac in the a/b subtypes and bi (omb) in c/d (the pairs the authors assign by), grn in b/c, TfAP-2 in T4 only, SoxN / Sox102F in all clusters."
    }
  ],
